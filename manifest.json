{
  "name": "RideLens — 라이딩 분석기",
  "short_name": "RideLens",
  "start_url": "https://happyprg.github.io/ridelens/app.html",
  "scope": "https://happyprg.github.io/ridelens/",
  "display": "standalone",
  "background_color": "#0d0f13",
  "theme_color": "#0d0f13",
  "icons": [
    {
      "src": "https://happyprg.github.io/ridelens/logo-icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "https://happyprg.github.io/ridelens/app.html",
      "accept": {
        "application/octet-stream": [
          ".fit"
        ],
        "application/gpx+xml": [
          ".gpx"
        ]
      }
    }
  ],
  "share_target": {
    "action": "https://happyprg.github.io/ridelens/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/octet-stream",
            "application/gpx+xml",
            "application/zip",
            ".fit",
            ".gpx",
            ".zip"
          ]
        }
      ]
    }
  }
}